{
  "mode": "simple",
  "preset": "balanced",
  "concurrency": 200,
  "per_proxy_concurrency": 10,
  "max_redirects": 10,
  "connect_timeout": 12.0,
  "request_timeout": 20.0,
  "head_first": true,
  "max_body_bytes": 262144,
  "retries": 3,
  "verify_tls": true,
  "https_fallback_http": true,
  "dedup": true,
  "prefer_https": true,
  "checkpoint_interval": 1.5,
  "output_dir": "output",
  "proxy_health_threshold": 3,
  "proxy_quarantine_seconds": 120.0,
  "proxy_check_timeout": 10.0,
  "dashboard_fps": 4.0,
  "color": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
}
